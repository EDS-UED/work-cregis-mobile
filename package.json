{
  "name": "work-cregis-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@eds-evergreen/mobile": "file:../eds-mobile/packages/mobile",
    "@expo/ui": "~58.0.28",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.19.0",
    "@react-navigation/native": "^7.4.0",
    "@react-navigation/native-stack": "^7.19.0",
    "@react-navigation/stack": "^7.12.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/prune-expo-router-hoist.mjs && node scripts/eas-preinstall-eds.mjs",
    "preios": "node scripts/ensure-eds-mobile.mjs",
    "preandroid": "node scripts/ensure-eds-mobile.mjs",
    "start": "CREGIS_ENSURE_EDS=0 node scripts/start-metro-with-eds-watch.mjs",
    "dev": "npm start",
    "start:with-ensure": "CREGIS_ENSURE_EDS=1 node scripts/start-metro-with-eds-watch.mjs",
    "start:metro-only": "expo start --port 8081",
    "start:fast": "CREGIS_ENSURE_EDS=0 CREGIS_EDS_TOKEN_WATCH=0 expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "ios:device": "RCT_METRO_PORT=8081 expo run:ios --device",
    "android:device": "RCT_METRO_PORT=8081 expo run:android --device",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "node scripts/eas-preinstall-eds.mjs",
    "preview:update": "node scripts/ensure-eds-mobile.mjs && eas update --channel preview --auto"
  },
  "overrides": {
    "react-native-worklets": "0.13.1"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "~0.13.1"
    }
  },
  "private": true
}
